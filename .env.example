# Copy to .env and adjust. All settings use the IGPT_ prefix (see src/insurance_gpt/config.py).
IGPT_HOST=127.0.0.1
IGPT_PORT=8000
IGPT_LOG_LEVEL=INFO
# Public hostname(s) of your tunnel / server, comma-separated (without https://)
# IGPT_PUBLIC_HOSTS=your-name.ngrok-free.app
# IGPT_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# IGPT_MIN_RELEVANCE=0.81
# IGPT_QDRANT_URL=http://localhost:6333   # default: in-memory
